# =============================================================================
# PayGuard — Local environment variable reference
#
# Copy this file to .env in each service directory and fill in the values.
# Never commit a populated .env file.
# =============================================================================

# ---- Shared -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# ---- Database (each service uses its own DB — adjust port per service) ------
# user-service      → 5433   db: payguard_users
# payment-service   → 5434   db: payguard_payments
# fraud-engine      → 5435   db: payguard_fraud
# notification      → 5436   db: payguard_notifications
# reconciliation    → 5437   db: payguard_reconciliation
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:<PORT>/payguard_<SERVICE>
SPRING_DATASOURCE_USERNAME=payguard
SPRING_DATASOURCE_PASSWORD=payguard_secret

# ---- Kafka ------------------------------------------------------------------
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_PROPERTIES_SCHEMA_REGISTRY_URL=http://localhost:8081

# ---- Redis (Fraud Engine only) -----------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ---- Stripe (Payment Service only) ------------------------------------------
STRIPE_API_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ---- JWT (Keycloak issues; all services validate) ---------------------------
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=payguard
PAYGUARD_JWKS_URI=http://localhost:8180/realms/payguard/protocol/openid-connect/certs
PAYGUARD_JWT_ISSUER=http://localhost:8180/realms/payguard
KEYCLOAK_ADMIN_CLIENT_ID=payguard-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=payguard-admin-secret-local-dev
KEYCLOAK_PUBLIC_CLIENT_ID=payguard-public

# ---- Keycloak Admin API (user-service only) ---------------------------------
# Used to provision users on register/invite and sync merchant attributes.

# ---- Service-to-service (Payment → Fraud Engine) ----------------------------
FRAUD_ENGINE_BASE_URL=http://localhost:8083
FRAUD_ENGINE_TIMEOUT_MS=200

# ---- Service-to-service (internal HTTP auth) --------------------------------
# Shared secret for /internal/** hops (payment→fraud, notification→user-service)
PAYGUARD_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-local-dev-token

# ---- Service-to-service (Notification → User Service) -----------------------
USER_SERVICE_BASE_URL=http://localhost:8086
