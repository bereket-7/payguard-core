{
  "realm": "payguard",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "MERCHANT_ADMIN", "description": "Merchant administrator" },
      { "name": "MERCHANT_ANALYST", "description": "Merchant analyst — read and review only" },
      { "name": "PLATFORM_ADMIN", "description": "Cross-merchant platform operator" }
    ]
  },
  "clientScopes": [
    {
      "name": "payguard-api",
      "description": "PayGuard API JWT claims",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "payguard-sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "payguard_user_id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "merchant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "merchant_id",
            "claim.name": "merchant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "merchant-tier",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "merchant_tier",
            "claim.name": "merchant_tier",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "payguard-scope",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "scope",
            "claim.name": "scope",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "payguard-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["role_list", "profile", "email", "payguard-api"],
  "clients": [
    {
      "clientId": "payguard-public",
      "name": "PayGuard Public Client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:8090/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:8090"],
      "defaultClientScopes": ["role_list", "profile", "email", "payguard-api"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "payguard-admin",
      "name": "PayGuard Admin Service Account",
      "enabled": true,
      "publicClient": false,
      "secret": "payguard-admin-secret-local-dev",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["role_list", "profile", "email"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-payguard-admin",
      "enabled": true,
      "serviceAccountClientId": "payguard-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "manage-realm"
        ]
      }
    }
  ]
}
